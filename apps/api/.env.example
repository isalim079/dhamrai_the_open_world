# Yarn Classic 1.22.22; backend gateway for the browser-first game.
# Never commit a populated .env. Production fails closed for absent configuration.
NODE_ENV=development
PORT=3000
BROWSER_ORIGIN=http://localhost:5173
# Production requires a real PostgreSQL connection and installed pg driver.
DATABASE_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must exactly match the Google Cloud registered URI; HTTPS required in production.
GOOGLE_REDIRECT_URI=http://localhost:5173/oauth/callback
# Generate each secret separately. No example/development key works in production.
# openssl rand -hex 32
TOKEN_ENCRYPTION_KEY_HEX=
# openssl rand -base64 48
SESSION_SECRET=
# Production always selects the real Drive adapter and requires this flag.
USE_REAL_GOOGLE_DRIVE=false
# Separate disposable database for opt-in real integration tests, never production.
TEST_DATABASE_URL=
